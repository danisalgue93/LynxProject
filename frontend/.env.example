# ──────────────────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# These are injected into the Vite bundle at build time. They are NOT secret —
# they're embedded in the JavaScript sent to all users. Never include private keys,
# API secrets, or authentication tokens here.
#
# For production deployments, pass these via Docker build args or CI/CD secrets:
#   docker compose build --build-arg VITE_API_URL=https://yourdomain.com
#
# Server-side secrets (MOONPAY_SECRET_KEY, etc.) should NOT be prefixed with VITE_
# and should be configured in the backend only.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API endpoint (required)
# Development: http://localhost:4000
# Production: https://yourdomain.com
VITE_API_URL=http://localhost:4000

# Solana blockchain configuration (required)
# Network: mainnet-beta (production) or devnet (testing)
VITE_SOLANA_NETWORK=devnet

# Custom RPC endpoint (optional)
# Leave empty to use the default for the network
# Recommended: Helius (https://helius.dev), QuickNode (https://www.quicknode.com)
# VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Treasury wallet public key (required, embedded in frontend)
# Used by the wallet feature to send on-chain deposits
VITE_TREASURY_WALLET=YourTreasuryWalletPublicKey111111111111111111

# Anchor program deployment IDs (required for on-chain interactions)
VITE_PROGRAM_ID=CiKuW8r71WnTLkGAKvFyYhtV2UhuJ4j8swDPDc8PEXvu
VITE_LYNX_MINT=

# Magic Link email login (required)
# Sign up: https://dashboard.magic.link
# Get publishable key from: Magic Dashboard → App Settings
# NOTE: This is a PUBLIC key (not a secret)
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX

# MoonPay on-ramp integration (required)
# Sign up: https://dashboard.moonpay.com
# Get publishable key from: MoonPay Dashboard → API Keys
# NOTE: This is a PUBLIC key (use pk_test_ for sandbox)
VITE_MOONPAY_API_KEY=pk_test_XXXXXXXXXXXXXXXX

# MoonPay secret key (SERVER-SIDE ONLY, never expose to frontend!)
# This must be configured in the backend/server.ts, not here
# Get from: MoonPay Dashboard → API Keys (secret key)
# Do NOT prefix with VITE_ — keep it private!
MOONPAY_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX

# Gemini AI integration (optional)
# Leave empty to disable AI features
# Get API key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy...

# Error monitoring (Sentry) — optional but recommended
# Create React project: https://sentry.io
# Get DSN from: Sentry Dashboard → Project Settings → Client Keys
VITE_SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX
