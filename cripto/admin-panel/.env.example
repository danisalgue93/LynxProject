# Copy to .env.local. Never commit real secrets.

RPC_URL=https://api.devnet.solana.com
# Must match declare_id!() in cripto/programs/lynx_project/src/lib.rs and the
# [programs.*] entry in cripto/Anchor.toml. This example previously pointed at a
# different program id than the one the contract actually declares, so a panel
# configured from it would query the wrong program and simply find no markets.
PROGRAM_ID=CiKuW8r71WnTLkGAKvFyYhtV2UhuJ4j8swDPDc8PEXvu

# Base58-encoded 64-byte Solana secret key for the current ProtocolConfig admin.
# Generate from an id.json with a trusted local script, then store it in a password manager.
ADMIN_KEYPAIR_BS58=replace_me

# Password must be stored as a bcrypt hash. Generate with:
#   node -e "const b=require('bcryptjs'); b.hash('your-password',12).then(h=>console.log(h))"
#
# ⚠️ ESCAPE EVERY `$` AS `\$` IN THIS FILE.
# Next.js expands `$VAR` references inside .env files, and a bcrypt digest begins
# with `$2a$12$…`. Unescaped, Next resolves `$2a` and `$12` as undefined variables
# and the value silently becomes an EMPTY STRING — every login then fails with a
# 500, and the previous version of this example (`ADMIN_PASSWORD=$2a$12$replace…`)
# taught exactly that mistake. Storing the password in plaintext instead is no
# workaround: bcrypt.compare() returns false for a non-hash, so every correct
# password is rejected with a 401.
#
# Either escape it as below, or pass ADMIN_PASSWORD as a real environment
# variable / secret mount, which is never expanded.
ADMIN_PASSWORD=\$2a\$12\$replace_with_bcrypt_hash_output
SESSION_SECRET=replace_with_at_least_32_random_characters

# ── Second factor (REQUIRED) ─────────────────────────────────────────────────
# TOTP (RFC 6238) from an authenticator app — Google Authenticator, Authy, 1Password.
# The panel refuses to log anyone in while this is unset.
#
# Telegram used to deliver the second factor and has been removed: it put a third
# party's uptime on the critical path of an emergency panel, which is exactly the
# moment you cannot afford it. TOTP needs only your phone and a correct clock.
#
# Generate one secret PER ADMIN (never share it between the two multisig admins):
#   node -e "const c=require('crypto'); let s=''; for(const b of c.randomBytes(20)) s+='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'[b%32]; console.log(s)"
# Then add it to that admin's authenticator as a base32 secret.
ADMIN_TOTP_SECRET=

# Comma-separated host allowlist for the admin app.
# Keep localhost for local use; add your private tunnel host only when needed.
ADMIN_ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001

# Keep false unless a trusted proxy/tunnel overwrites X-Real-IP and
# X-Forwarded-For before traffic reaches Next.js.
ADMIN_TRUST_PROXY_HEADERS=false

# Local-only testing helpers. Never enable in production.
ADMIN_DEV_MODE=false

MOCK_MARKETS=false
