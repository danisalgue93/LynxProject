# ──────────────────────────────────────────────────────────────────────────────
# Lynx Market — Root .env for Docker Compose
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in all required values before running `docker compose up`
#
# For production deployments, use a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, etc.) instead of storing sensitive values in this file.
#
# See DEPLOYMENT.md for complete instructions.
# See SECURITY.md for hardening procedures.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Database connection credentials (required)
# Generate password with: openssl rand -hex 32
POSTGRES_DB=lynx_market
POSTGRES_USER=lynx
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Backend Auth ────────────────────────────────────────────────────────────────
# JWT secrets (required)
# Generate with: openssl rand -hex 64
# MUST be different from each other
JWT_SECRET=CHANGE_ME_64_char_hex_secret
REFRESH_SECRET=CHANGE_ME_different_64_char_hex_secret
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d

# ── CORS & Domains ──────────────────────────────────────────────────────────────
# Your production domain (required, no trailing slash)
# In production: must be HTTPS
CORS_ORIGIN=https://yourdomain.com

# ── Admin Access ────────────────────────────────────────────────────────────────
# Admin wallet addresses (required, comma-separated)
# Minimum 2 wallets recommended for mainnet
ADMIN_WALLETS=YourAdminWallet1111111111111111111111111111,YourAdminWallet2222222222222222222222222222

# Machine admin token for backend API scripts (required)
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=CHANGE_ME_admin_api_token

# ── Solana Blockchain ───────────────────────────────────────────────────────────
# Network selection (required)
# Options: mainnet-beta (production), devnet (testing)
SOLANA_CLUSTER=mainnet-beta

# RPC endpoint (recommended to use a paid service: Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Anchor program deployment IDs (required for mainnet)
PROGRAM_ID=YourProgramIdOnMainnet1111111111111111111111111111
LYNX_MINT=YourLynxMintAddressOnMainnet11111111111111111111111

# ── Treasury & Managed Wallets ──────────────────────────────────────────────────
# Treasury wallet that receives deposits and signs withdrawals (required)
TREASURY_WALLET=YourTreasuryWalletPublicKey111111111111111111

# Treasury secret key in Base58 format (required, keep very secure)
# Rotate annually and keep encrypted in a secrets manager
TREASURY_SECRET_KEY=YourTreasurySecretKeyInBase58CHANGEME

# Random seed for deterministic managed-wallet derivation (required)
# Generate with: openssl rand -hex 32
# Used to derive stable wallet addresses for Magic Link users
MANAGED_WALLET_SEED=CHANGE_ME_random_seed

# ── Frontend Environment (injected at build time into Vite bundle) ────────────────
# Magic Link email login (required for email auth)
# Get key from: https://dashboard.magic.link
VITE_MAGIC_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX

# MoonPay on-ramp integration (required for fiat purchasing)
# Get key from: https://dashboard.moonpay.com
VITE_MOONPAY_API_KEY=pk_live_XXXXXXXXXXXXXXXX

# MoonPay secret key for URL signing (server-side only, never expose to frontend)
MOONPAY_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX

# ── Email Verification ──────────────────────────────────────────────────────────
# Require email verification on signup (recommended: true in production)
REQUIRE_EMAIL_VERIFICATION=true

# Resend API key for transactional email (required for production email verification)
# Sign up: https://resend.com (free tier: 3000 emails/month)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Verified sender email address (required if using Resend)
# Must be verified in your Resend account
EMAIL_FROM=Lynx Market <noreply@yourdomain.com>

# Application URL for email links (required)
# Should match CORS_ORIGIN
APP_URL=https://yourdomain.com

# ── Error Monitoring ────────────────────────────────────────────────────────────
# Sentry DSN for backend error tracking (optional but recommended)
# Create project: https://sentry.io (Node.js)
SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX

# Sentry DSN for frontend error tracking (optional but recommended)
# Create project: https://sentry.io (React)
VITE_SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX
