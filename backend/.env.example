PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (use PostgreSQL for production)
STORE_DRIVER=prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lynx_market?schema=public

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
REFRESH_EXPIRY=7d
REQUIRE_EMAIL_VERIFICATION=true

# Two production admins are defined by wallet address. Keep this as a comma-separated list.
ADMIN_WALLETS=9Jga2n3B8bQr1gCJJRE6Ei7XhsntoUQ1bYWJBSZPYr5d,AdminWalletDev22222222222222222222222222222222

# Solana        
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CiKuW8r71WnTLkGAKvFyYhtV2UhuJ4j8swDPDc8PEXvu
LYNX_MINT=
# Public address of the treasury wallet that receives deposits and signs withdrawals.
TREASURY_WALLET=
# Base58-encoded secret key of the treasury wallet. Required to send real on-chain SOL withdrawals.
TREASURY_SECRET_KEY=
# Server-only secret used to deterministically derive a real Solana address for managed (Magic) accounts. Required for those accounts to receive on-chain SOL withdrawals.
MANAGED_WALLET_SEED=

# ── On-chain prediction market indexer + keeper (backend/src/chain.ts) ─────────
# Read-only mirror of on-chain Market/PredictionOrder/UserPosition accounts, used
# to show fast trading UI without the backend custodying any of this money
# (see auditoria_lynx_project.md). Uses the same PROGRAM_ID/SOLANA_RPC_URL above.
CHAIN_INDEXER_INTERVAL_MS=8000
CHAIN_KEEPER_INTERVAL_MS=6000
# Base58-encoded secret key of a keeper wallet that ONLY pays gas fees to execute
# already-fulfilled prediction limit orders (execute_prediction_limit_order_sol/lynx).
# This wallet never holds user funds and cannot move anyone's money on its own —
# the program re-validates the price condition on-chain before any transfer.
# Keep its SOL balance small (just enough for tx fees) and top it up periodically.
# If unset, limit orders still work but only execute when the user (or a
# third-party keeper) triggers them manually.
KEEPER_KEYPAIR_BS58=

# ── Dual-admin approval for manual balance credits (backend/src/creditApprovals.ts) ──
# INTERNAL/CARD deposits and legacy (off-chain) market resolutions now require
# TWO different admin accounts (propose + approve), never the shared
# ADMIN_API_TOKEN. See auditoria_lynx_project.md findings A1/A2/C3.
MAX_MANUAL_CREDIT_SOL=5
MAX_MANUAL_CREDIT_LYNX=50000

# Optional machine admin token for backend scripts. Do not use it from the browser.
ADMIN_API_TOKEN=admin-token-change-in-production

# ── Email (Resend) ──────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier supports 3000 emails/month
# Without this, email verification and password reset only work in dev mode
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=Lynx Market <noreply@yourdomain.com>
APP_URL=https://yourdomain.com

# ── Error monitoring (Sentry) ───────────────────────────────────────────────────
# Create a Node.js project at https://sentry.io and paste the DSN here
SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX
