PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (use PostgreSQL for production)
# Development: Can be omitted to use in-memory store
# Production: postgresql://user:pass@host/dbname?schema=public
STORE_DRIVER=prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lynx_market?schema=public

# Distributed rate limiting (required for multi-instance deployments)
# Leave unset for local dev / single-instance deployments (falls back to memory)
# Production: redis://localhost:6379 or managed Redis service
REDIS_URL=redis://localhost:6379

# Authentication (JWT secrets must be 64+ hex characters)
# Generate with: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
REFRESH_EXPIRY=7d
REQUIRE_EMAIL_VERIFICATION=true

# Admin access (Solana wallet addresses, comma-separated)
# Minimum 2 wallets recommended for mainnet
ADMIN_WALLETS=9Jga2n3B8bQr1gCJJRE6Ei7XhsntoUQ1bYWJBSZPYr5d,AdminWalletDev22222222222222222222222222222222

# Solana blockchain configuration
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CiKuW8r71WnTLkGAKvFyYhtV2UhuJ4j8swDPDc8PEXvu
LYNX_MINT=

# Treasury wallet (receives deposits, signs withdrawals)
# Generate with: solana-keygen pubkey treasury-keypair.json
TREASURY_WALLET=
# Base58-encoded secret key (keep encrypted, rotate annually)
TREASURY_SECRET_KEY=
# Random seed for deterministic Magic wallet derivation
# Generate with: openssl rand -hex 32
MANAGED_WALLET_SEED=

# Admin API token (never expose to frontend)
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=admin-token-change-in-production

# Email verification (Resend)
# Sign up: https://resend.com (free tier: 3000 emails/month)
# Without this, email verification only works in dev mode
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=Lynx Market <noreply@yourdomain.com>
APP_URL=https://yourdomain.com

# Error monitoring (Sentry)
# Create Node.js project at https://sentry.io
SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX
